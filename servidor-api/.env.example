# Endereço base da Central (termina em /api) e credencial sva_ de LICENCIAMENTO do produto h3suporte.
CENTRAL_URL=https://keys.h3info.com/api
CENTRAL_CREDENCIAL=sva_troque_pela_credencial
# Porta e banco (SQLite).
PORTA=21114
BANCO=dados/h3suporte.db
# Revalida a sessão na Central a cada N segundos; aceita a sessão por até N horas com a Central fora.
REVALIDAR_SEG=300
TOLERANCIA_HORAS=72
# 1 quando estiver atrás de proxy reverso (usa X-Forwarded-For para o IP do cliente).
CONFIAR_PROXY=1
