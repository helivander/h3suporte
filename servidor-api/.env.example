# Credencial sva_ de LICENCIAMENTO do produto h3suporte (Central: Produtos -> h3suporte -> Credenciais).
CENTRAL_CREDENCIAL=sva_troque_pela_credencial

# Em produção (docker-compose.prod.yml) o padrão é a API da Central pela rede interna: http://api:3001
# Fora dele, use o endereço público com /api no fim:
# CENTRAL_URL=https://keys.h3info.com/api

# Opcionais
# REDE_CENTRAL=central_interna   # rede Docker da Central (projeto "central", rede "interna")
# REVALIDAR_SEG=300              # revalida a sessão na Central a cada N segundos
# TOLERANCIA_HORAS=72            # aceita a sessão por até N horas com a Central fora
