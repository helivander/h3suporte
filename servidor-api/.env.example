# Credencial sva_ de LICENCIAMENTO do produto h3suporte (Central: Produtos -> h3suporte -> Credenciais).
CENTRAL_CREDENCIAL=sva_troque_pela_credencial

# Em produção (docker-compose.prod.yml) o padrão é a API da Central pela rede interna: http://api:3001
# Fora dele, use o endereço público com /api no fim:
# CENTRAL_URL=https://keys.h3info.com/api

# Chave que cifra as senhas de "Meus dispositivos" (openssl rand -hex 32). Sem ela o recurso fica desligado.
# Guarde uma cópia em lugar seguro: sem a chave as senhas guardadas não podem ser lidas.
CHAVE_DISPOSITIVOS=

# Opcionais
# REDE_CENTRAL=central_interna   # rede Docker da Central (projeto "central", rede "interna")
# REVALIDAR_SEG=300              # revalida a sessão na Central a cada N segundos
# TOLERANCIA_HORAS=72            # aceita a sessão por até N horas com a Central fora
# GITHUB_REPO=helivander/h3suporte   # releases que o atualizador do app oferece (/api/versao)
# GITHUB_TOKEN=                      # token só de leitura; sem ele só aumenta o limite de consultas, e os instaladores com IA ficam desligados
# PLANOS_IA=DEV                      # planos de assinatura que veem e baixam o instalador com IA (separe por vírgula)
# DIR_IA=dados/ia                    # onde os instaladores com IA extraídos ficam em disco
